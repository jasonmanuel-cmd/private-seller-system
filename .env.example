# Environment variables (copy to .env if you want to keep these set between shells)
# Leave this file untracked — values belong on the host, not in the repo.

# Dashboard auth (recommended for any non-localhost deployment)
# DASHBOARD_TOKEN=set-a-long-random-string-here

# Flask session key — use a stable value if you run more than one process or restart often
# SECRET_KEY=set-a-stable-random-string-here

# Optional: override the on-disk lead database path (e.g. when mounting a persistent disk)
# DB_PATH=data/leads.db

# Property-intelligence reports remain local by default.
# REPORT_DIR=data/reports

# Unattended mode settings. The program does not install a scheduler for you.
# RUN_INTERVAL_MINUTES=60
# OPPORTUNITY_THRESHOLD=75
# WATCHLIST_THRESHOLD=50
# STALE_DATA_DAYS=30
# MIN_COMP_COUNT=3
